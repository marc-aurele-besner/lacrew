{
  "name": "@lacrew/docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm content && next build && node ./scripts/postbuild.mjs",
    "content": "node ./scripts/run-typedoc.mjs && node ./scripts/prepare-content.mjs",
    "dev": "pnpm content && next dev",
    "start": "pnpm dlx serve out",
    "clean": "rm -rf out .next content/reference content/spec.md",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "fumadocs-core": "^16.14.4",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.4",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0"
  }
}
