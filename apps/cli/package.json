{
  "name": "@lacrew/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/lacrew.git",
    "directory": "apps/cli"
  },
  "homepage": "https://lacrew.xyz",
  "type": "module",
  "bin": {
    "lacrew": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/orch.test.ts src/scaffold.test.ts src/env.test.ts src/crews.test.ts src/connectors.test.ts src/skills.test.ts src/mcp.test.ts src/flowTriggers.test.ts src/heartbeat.test.ts src/budget.test.ts src/pnl.test.ts src/planRequired.test.ts src/dualControl.test.ts src/evals.test.ts src/intents.test.ts src/gas.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lacrew/core": "workspace:*",
    "@lacrew/flows": "workspace:*",
    "@lacrew/orchestrator": "workspace:*",
    "@lacrew/sdk": "workspace:*",
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  }
}
