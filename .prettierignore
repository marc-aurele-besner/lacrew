# Prettier does not read .gitignore, so build output has to be named here or
# `pnpm format` spends its time rewriting artifacts nobody reviews.
node_modules/
dist/
build/
out/
.next/
coverage/
.turbo/
.pnpm-store/

# Foundry artifacts
contracts/cache/
contracts/out/
contracts/broadcast/
contracts/lib/

# Generated, and owned by the tool that generates it. Reformatting a drizzle
# snapshot puts the checked-in file out of step with what `db:generate` writes
# next, which turns the following migration into a diff nobody can read.
packages/db/drizzle/

# Written by packages/core/scripts/sync-abis.mjs from the Foundry build, and
# checked in so consumers need no toolchain. Same reasoning as the drizzle
# snapshots: prettier's copy and the generator's copy differ, so formatting
# these makes the next `pnpm build` look like an unexplained source change.
packages/core/src/abis.ts
packages/core/src/bytecode.generated.ts
packages/core/src/deployments.generated.ts

# typedoc output, regenerated on every docs build
apps/docs/content/reference/

# The root SPEC.md, copied into the docs on every build
apps/docs/content/spec.md

# Vendored skill documents — not this repo's prose to restyle
.claude/

pnpm-lock.yaml
