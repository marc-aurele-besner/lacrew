contracts/cache/
contracts/out/
contracts/broadcast/
contracts/lib/

# Generated, and owned by the tool that generates it. Reformatting a drizzle
# snapshot puts the checked-in file out of step with what `db:generate` writes
# next, which turns the following migration into a diff nobody can read.
packages/db/drizzle/

# typedoc output, regenerated on every docs build
apps/docs/content/reference/

