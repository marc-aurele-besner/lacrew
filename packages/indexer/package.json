{
  "name": "@lacrew/indexer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/lacrew.git",
    "directory": "packages/indexer"
  },
  "homepage": "https://lacrew.xyz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/store.test.ts src/watcher.test.ts src/sinks/sinks.test.ts"
  },
  "dependencies": {
    "@lacrew/core": "workspace:*",
    "@lacrew/db": "workspace:*",
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  }
}
