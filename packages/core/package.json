{
  "name": "@lacrew/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/lacrew.git",
    "directory": "packages/core"
  },
  "homepage": "https://lacrew.xyz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-abis": "node scripts/sync-abis.mjs",
    "addresses:env": "node scripts/addresses-env.mjs",
    "build": "node scripts/sync-abis.mjs && tsc -p tsconfig.json",
    "test": "node --import tsx --test src/constants.test.ts src/sessionScopes.test.ts src/node.test.ts src/rootAuth.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  }
}
