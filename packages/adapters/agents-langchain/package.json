{
  "name": "@lacrew/adapter-agents-langchain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/lacrew.git",
    "directory": "packages/adapters/agents-langchain"
  },
  "homepage": "https://lacrew.xyz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/index.test.ts"
  },
  "dependencies": {
    "@lacrew/adapter-agents-mcp": "workspace:*",
    "@lacrew/flows": "workspace:*"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.3",
    "@types/node": "^26.0.0",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  }
}
