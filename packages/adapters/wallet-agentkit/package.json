{
  "name": "@lacrew/adapter-wallet-agentkit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marc-aurele-besner/lacrew.git",
    "directory": "packages/adapters/wallet-agentkit"
  },
  "homepage": "https://lacrew.xyz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/index.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "smoke:cdp": "node --import tsx scripts/smoke-cdp.ts"
  },
  "dependencies": {
    "@lacrew/core": "workspace:*"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.54.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@coinbase/cdp-sdk": {
      "optional": true
    }
  }
}
