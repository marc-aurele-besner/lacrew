# Contracts / deploy
HUMAN_ROOT=
# First public testnet (Ethereum Sepolia)
SEPOLIA_RPC_URL=
# Optional later Base Sepolia slot
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
# Anvil account #0 — deploys DeployMockOrg, signs proposals, sponsors session gas.
# The orchestrator runs onchain only when this and ANVIL_RPC are both set; leaving
# it empty is what used to drop the whole stack into fabricated data.
# DEMO ONLY — never use on mainnet / funded networks. Replace for any real chain.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Local Anvil (indexer / onchain CLI). Start the whole stack with: pnpm dev:stack
ANVIL_RPC=http://127.0.0.1:8545
CHAIN_ID=31337
# Relative paths resolve against the workspace root, not the running process's
# cwd — the indexer writes this file and the orchestrator reads it from a
# different directory.
INDEXER_PATH=.lacrew/indexer.json

# Anvil account #1 — signs EscalationRouter.resolve as manager (DeployMockOrg on 31337).
# DEMO ONLY — never use on mainnet / funded networks.
MANAGER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Optional override; defaults to Anvil #1 on chain 31337.
# MANAGER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Optional dedicated session-key issuer. When set, it signs SessionRegistry
# issue/revoke instead of PRIVATE_KEY, so the orchestrator can issue bounded,
# expiring session keys without holding root. On a local chain where PRIVATE_KEY
# is root the orchestrator authorises this key at boot (setIssuer); on a real
# chain root authorises it out of band and the orchestrator only holds the key.
# LACREW_ISSUER_PRIVATE_KEY=0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97

# Root authorization for session revoke/rotate (F0.7). Unset, both routes are
# open to anyone who can reach this orchestrator. Set, they demand a fresh proof
# from the workspace root, verified here — so nothing in front of this process
# can stand in for the human. Check /health .rootAuth for what is actually on.
# LACREW_ROOT_AUTH=wallet
# LACREW_ROOT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# LACREW_ROOT_AUTH=passkey
# LACREW_ROOT_PASSKEY_ID=
# LACREW_ROOT_PASSKEY_PUBKEY=
# LACREW_ROOT_PASSKEY_RPID=localhost
# LACREW_ROOT_PASSKEY_ORIGIN=http://localhost:3000
# LACREW_ROOT_CHALLENGE_TTL_SEC=300

# Postgres (Neon connection string, or local Docker — see docker-compose.yml)
# docker compose up -d
# DATABASE_URL=postgres://lacrew:lacrew@localhost:5432/lacrew
DATABASE_URL=

# Orchestrator
PORT=8788
# Require "Authorization: Bearer <token>" on all orchestrator routes except GET /health.
# Unset = open (localhost demos only). lacrew.xyz API + examples read the same env.
# LACREW_ORCH_TOKEN=
# Seals session private keys at rest so a restart reuses the live onchain
# session instead of issuing (and gas-funding) a replacement. Unset is
# supported: sessions simply do not survive a restart. 32 bytes, base64 —
# generate with: openssl rand -base64 32
LACREW_SESSION_KEY=
# Tried on decrypt only, so the key above can be rotated without downtime.
# LACREW_SESSION_KEY_PREVIOUS=
# ETH topped up to a session key, and only when it is short. Default 0.01.
# SESSION_GAS_STIPEND_ETH=0.01

# pg-boss cron when DATABASE_URL is set (default hourly). Surfaced on GET /epoch + /health.
# EPOCH_CRON=0 * * * *
# Memory-queue interval (ms) when DATABASE_URL is unset. Opt-in; 0/unset = POST /epoch only.
# EPOCH_INTERVAL_MS=3600000

# Model provider (F1.7) — Memory stub when no key is set. Otherwise the first
# key below wins, in this order: Anthropic, OpenAI, OpenRouter.
# Pin one explicitly with LACREW_MODEL_PROVIDER=memory|anthropic|openai|openrouter
# LACREW_MODEL_PROVIDER=

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Messages API requires an output cap; thinking counts against it (default 16000).
# ANTHROPIC_MAX_TOKENS=16000

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Inference cost budgets (F2.28) — what a crew's model calls may cost you, which
# the onchain policy stack does not see. Budgets themselves are set per crew
# (`lacrew budget set --crew trading --usd 200 --hard --enable`); the only env
# knob is the price table, which overrides the built-in list prices *whole*.
# Anything unmatched is counted as unpriced, never as free.
# LACREW_MODEL_PRICES={"claude-opus":{"inputPerMTok":15,"outputPerMTok":75}}

